# .env.example — Lunar Habitat AI — Environment Configuration Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env  (which is .gitignore'd)
#   2. Fill in your actual API key
#   3. Never commit the .env file
#
# The .env file is read manually via:
#   Windows PowerShell:  $env:GEMINI_API_KEY = "your_key_here"
#   Linux/macOS:         export GEMINI_API_KEY="your_key_here"
#
# Or use python-dotenv if added as a dependency:
#   from dotenv import load_dotenv; load_dotenv()

# --------------------------------------------------------------------------
# Gemini API Key (REQUIRED for live explanations)
# --------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
# If not set, the system uses deterministic fallback explanations.
# AHP rankings are NEVER affected by this setting.
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------------
# Optional: override default Gemini model
# --------------------------------------------------------------------------
# Default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
